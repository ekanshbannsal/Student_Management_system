<%- include('partials/header') %>

<div class="app-wrapper">
  <!-- Sidebar -->
  <%- include('partials/sidebar') %>

  <!-- Main Content Wrapper -->
  <div class="app-main">
    <!-- Navbar -->
    <%- include('partials/navbar', { pageTitle: 'Overview Dashboard' }) %>

    <!-- Page Content -->
    <main class="page-container">
      <!-- Flash Messages -->
      <%- include('partials/messages') %>

      <!-- Welcome Banner -->
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
          <h2 class="fw-bold mb-1 text-dark">Welcome, <%= currentUser ? currentUser.name : 'Administrator' %>!</h2>
          <p class="text-muted mb-0">Here is the latest snapshot of student enrollments and academic branches.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/students/add" class="btn btn-custom-primary">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add New Student</span>
          </a>
          <a href="/students" class="btn btn-custom-secondary">
            <i class="fa-solid fa-users"></i>
            <span>Browse All</span>
          </a>
        </div>
      </div>

      <!-- Statistics Cards Grid -->
      <div class="row g-4 mb-4">
        <!-- Total Students -->
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card card-primary">
            <div>
              <div class="stat-header">
                <span class="stat-title">Total Students</span>
                <div class="stat-icon icon-primary">
                  <i class="fa-solid fa-users-line"></i>
                </div>
              </div>
              <div class="stat-value"><%= stats.totalStudents %></div>
            </div>
            <p class="stat-subtext">
              <i class="fa-solid fa-arrow-trend-up text-primary"></i>
              <span>Total registered in MongoDB</span>
            </p>
          </div>
        </div>

        <!-- Male Students -->
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card card-success">
            <div>
              <div class="stat-header">
                <span class="stat-title">Male Students</span>
                <div class="stat-icon icon-success">
                  <i class="fa-solid fa-person"></i>
                </div>
              </div>
              <div class="stat-value"><%= stats.maleStudents %></div>
            </div>
            <p class="stat-subtext">
              <span class="fw-bold text-success">
                <%= stats.totalStudents > 0 ? Math.round((stats.maleStudents / stats.totalStudents) * 100) : 0 %>%
              </span>
              <span>of total student body</span>
            </p>
          </div>
        </div>

        <!-- Female Students -->
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card card-warning">
            <div>
              <div class="stat-header">
                <span class="stat-title">Female Students</span>
                <div class="stat-icon icon-warning">
                  <i class="fa-solid fa-person-dress"></i>
                </div>
              </div>
              <div class="stat-value"><%= stats.femaleStudents %></div>
            </div>
            <p class="stat-subtext">
              <span class="fw-bold text-warning">
                <%= stats.totalStudents > 0 ? Math.round((stats.femaleStudents / stats.totalStudents) * 100) : 0 %>%
              </span>
              <span>of total student body</span>
            </p>
          </div>
        </div>

        <!-- Total Branches / Courses -->
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card card-info">
            <div>
              <div class="stat-header">
                <span class="stat-title">Active Branches</span>
                <div class="stat-icon icon-info">
                  <i class="fa-solid fa-code-branch"></i>
                </div>
              </div>
              <div class="stat-value"><%= stats.totalBranches %></div>
            </div>
            <p class="stat-subtext">
              <span>Across <strong class="text-dark"><%= stats.totalCourses %></strong> degree programs</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Actions & Branch Distribution Row -->
      <div class="row g-4 mb-4">
        <!-- Branch Distribution Panel -->
        <div class="col-lg-5">
          <div class="custom-card h-100 mb-0">
            <div class="card-header-clean">
              <h3 class="h6 mb-0 fw-bold"><i class="fa-solid fa-chart-simple text-primary me-2"></i>Top Academic Branches</h3>
              <a href="/students" class="small text-muted">View all</a>
            </div>
            <div class="card-body-clean">
              <% if (branchStats && branchStats.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                  <% branchStats.forEach(function(b) { 
                    const percent = stats.totalStudents > 0 ? Math.round((b.count / stats.totalStudents) * 100) : 0;
                  %>
                    <div>
                      <div class="d-flex justify-content-between align-items-center mb-1 small">
                        <span class="fw-semibold text-dark"><%= b._id %></span>
                        <span class="text-muted"><%= b.count %> students (<%= percent %>%)</span>
                      </div>
                      <div class="progress" style="height: 8px; border-radius: 4px; background-color: #f1f5f9;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percent %>%" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="text-center py-4 text-muted">
                  <i class="fa-solid fa-chart-pie fs-3 mb-2 text-secondary"></i>
                  <p class="small mb-0">No branch data available yet. Enroll students to see analytics.</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- System Shortcuts -->
        <div class="col-lg-7">
          <div class="custom-card h-100 mb-0">
            <div class="card-header-clean">
              <h3 class="h6 mb-0 fw-bold"><i class="fa-solid fa-bolt text-warning me-2"></i>Quick Administrative Actions</h3>
            </div>
            <div class="card-body-clean">
              <div class="row g-3">
                <div class="col-sm-6">
                  <a href="/students/add" class="d-block p-3 rounded-3 border bg-light text-decoration-none h-100 transition-hover">
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-3 bg-primary-light text-primary p-3">
                        <i class="fa-solid fa-user-plus fs-4"></i>
                      </div>
                      <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Enroll New Student</h4>
                        <p class="small text-muted mb-0">Register details, courses and contact</p>
                      </div>
                    </div>
                  </a>
                </div>
                <div class="col-sm-6">
                  <a href="/students" class="d-block p-3 rounded-3 border bg-light text-decoration-none h-100 transition-hover">
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-3 bg-success-light text-success p-3">
                        <i class="fa-solid fa-filter fs-4"></i>
                      </div>
                      <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Filter & Search</h4>
                        <p class="small text-muted mb-0">Query by roll number, branch, or year</p>
                      </div>
                    </div>
                  </a>
                </div>
                <div class="col-sm-6">
                  <a href="/profile" class="d-block p-3 rounded-3 border bg-light text-decoration-none h-100 transition-hover">
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-3 bg-warning-light text-warning p-3">
                        <i class="fa-solid fa-key fs-4"></i>
                      </div>
                      <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Security & Password</h4>
                        <p class="small text-muted mb-0">Manage account and credentials</p>
                      </div>
                    </div>
                  </a>
                </div>
                <div class="col-sm-6">
                  <a href="/students?search=" class="d-block p-3 rounded-3 border bg-light text-decoration-none h-100 transition-hover">
                    <div class="d-flex align-items-center gap-3">
                      <div class="rounded-3 bg-info-light text-info p-3">
                        <i class="fa-solid fa-list-check fs-4"></i>
                      </div>
                      <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Full Directory</h4>
                        <p class="small text-muted mb-0">Export & inspect all active records</p>
                      </div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Students Table -->
      <div class="custom-card">
        <div class="card-header-clean">
          <div>
            <h3 class="h6 mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Recently Enrolled Students</h3>
            <small class="text-muted">Last 5 registrations saved in MongoDB</small>
          </div>
          <a href="/students" class="btn btn-sm btn-custom-secondary">
            <span>View All Students</span>
            <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
        </div>
        <div class="p-0">
          <% if (recentStudents && recentStudents.length > 0) { %>
            <div class="modern-table-container border-0">
              <table class="modern-table">
                <thead>
                  <tr>
                    <th>Student</th>
                    <th>Roll Number</th>
                    <th>Program</th>
                    <th>Branch</th>
                    <th>Year</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentStudents.forEach(function(student) { %>
                    <tr>
                      <td>
                        <div class="student-name-cell">
                          <div class="student-avatar">
                            <%= student.name ? student.name.charAt(0).toUpperCase() : 'S' %>
                          </div>
                          <div>
                            <a href="/students/<%= student._id %>" class="fw-bold text-dark text-decoration-none">
                              <%= student.name %>
                            </a>
                            <div class="text-muted small"><%= student.email %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="roll-badge"><%= student.rollNumber %></span>
                      </td>
                      <td>
                        <span class="badge-soft badge-soft-primary"><%= student.course %></span>
                      </td>
                      <td>
                        <span class="text-secondary small fw-medium"><%= student.branch %></span>
                      </td>
                      <td>
                        <span class="badge-soft badge-soft-secondary"><%= student.year %></span>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-1">
                          <a href="/students/<%= student._id %>" class="btn-action-icon" title="View Profile">
                            <i class="fa-solid fa-eye"></i>
                          </a>
                          <a href="/students/<%= student._id %>/edit" class="btn-action-icon" title="Edit Student">
                            <i class="fa-solid fa-pen-to-square"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-5">
              <div class="mb-3 text-muted">
                <i class="fa-solid fa-user-graduate fs-1"></i>
              </div>
              <h5 class="fw-bold text-dark">No Students Enrolled Yet</h5>
              <p class="text-muted small mb-3">Begin by adding your first student record to the system.</p>
              <a href="/students/add" class="btn btn-custom-primary">
                <i class="fa-solid fa-user-plus me-2"></i>Add First Student
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('partials/footer') %>
