<%- include('../partials/header') %>

<div class="app-wrapper">
  <!-- Sidebar -->
  <%- include('../partials/sidebar') %>

  <!-- Main Content Wrapper -->
  <div class="app-main">
    <!-- Navbar -->
    <%- include('../partials/navbar', { pageTitle: 'Student Directory' }) %>

    <!-- Page Content -->
    <main class="page-container">
      <!-- Flash Messages -->
      <%- include('../partials/messages') %>

      <!-- Top Page Action Header -->
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
          <h2 class="fw-bold mb-1 text-dark">All Students</h2>
          <p class="text-muted mb-0">Browse, search, filter, and manage all enrolled students.</p>
        </div>
        <div>
          <a href="/students/add" class="btn btn-custom-primary shadow-sm">
            <i class="fa-solid fa-user-plus"></i>
            <span>Add New Student</span>
          </a>
        </div>
      </div>

      <!-- Search and Filter Panel -->
      <div class="filter-card">
        <form action="/students" method="GET" class="row g-3 align-items-end">
          <!-- Keyword Search -->
          <div class="col-md-4 col-lg-3">
            <label for="searchInput" class="form-label-custom">Search</label>
            <div class="input-group">
              <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="fa-solid fa-magnifying-glass"></i>
              </span>
              <input 
                type="text" 
                class="form-control-custom border-start-0 ps-0" 
                id="searchInput"
                name="search" 
                placeholder="Name, Roll, Email, Branch..." 
                value="<%= filters.search %>"
              >
            </div>
          </div>

          <!-- Course Filter -->
          <div class="col-6 col-md-2">
            <label for="courseFilter" class="form-label-custom">Course</label>
            <select name="course" id="courseFilter" class="form-select-custom">
              <option value="All" <%= filters.course === 'All' ? 'selected' : '' %>>All Courses</option>
              <% const courseOptions = ['B.Tech', 'BCA', 'B.Sc', 'MCA', 'M.Tech', 'BBA', 'MBA', 'Diploma']; %>
              <% courseOptions.forEach(function(c) { %>
                <option value="<%= c %>" <%= filters.course === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </div>

          <!-- Branch Filter -->
          <div class="col-6 col-md-3 col-lg-2">
            <label for="branchFilter" class="form-label-custom">Branch</label>
            <select name="branch" id="branchFilter" class="form-select-custom">
              <option value="All" <%= filters.branch === 'All' ? 'selected' : '' %>>All Branches</option>
              <% const branchOptions = [
                'Computer Science (CSE)',
                'Information Technology (IT)',
                'Electronics & Communication (ECE)',
                'Mechanical Engineering (ME)',
                'Civil Engineering (CE)',
                'Electrical Engineering (EE)',
                'Artificial Intelligence & Data Science (AI/DS)',
                'Business Administration',
                'Other'
              ]; %>
              <% branchOptions.forEach(function(b) { %>
                <option value="<%= b %>" <%= filters.branch === b ? 'selected' : '' %>><%= b %></option>
              <% }); %>
            </select>
          </div>

          <!-- Year Filter -->
          <div class="col-6 col-md-2 col-lg-2">
            <label for="yearFilter" class="form-label-custom">Year</label>
            <select name="year" id="yearFilter" class="form-select-custom">
              <option value="All" <%= filters.year === 'All' ? 'selected' : '' %>>All Years</option>
              <option value="1st Year" <%= filters.year === '1st Year' ? 'selected' : '' %>>1st Year</option>
              <option value="2nd Year" <%= filters.year === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
              <option value="3rd Year" <%= filters.year === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
              <option value="4th Year" <%= filters.year === '4th Year' ? 'selected' : '' %>>4th Year</option>
            </select>
          </div>

          <!-- Gender Filter -->
          <div class="col-6 col-md-2 col-lg-1">
            <label for="genderFilter" class="form-label-custom">Gender</label>
            <select name="gender" id="genderFilter" class="form-select-custom">
              <option value="All" <%= filters.gender === 'All' ? 'selected' : '' %>>All</option>
              <option value="Male" <%= filters.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= filters.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= filters.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <!-- Buttons -->
          <div class="col-12 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-custom-primary flex-grow-1 justify-content-center">
              <i class="fa-solid fa-filter"></i>
              <span>Apply</span>
            </button>
            <a href="/students" class="btn btn-custom-secondary" title="Clear Filters">
              <i class="fa-solid fa-rotate-left"></i>
            </a>
          </div>
        </form>
      </div>

      <!-- Students Table Card -->
      <div class="custom-card">
        <div class="card-header-clean">
          <div class="d-flex align-items-center gap-2">
            <h3 class="h6 mb-0 fw-bold">Student Records</h3>
            <span class="badge-soft badge-soft-primary"><%= totalStudents %> Total</span>
          </div>
          <div class="small text-muted">
            Showing Page <%= page %> of <%= totalPages %>
          </div>
        </div>

        <div class="p-0">
          <% if (students && students.length > 0) { %>
            <div class="modern-table-container border-0">
              <table class="modern-table">
                <thead>
                  <tr>
                    <th style="width: 50px;">#</th>
                    <th>Name</th>
                    <th>Roll Number</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Branch</th>
                    <th>Year</th>
                    <th>Phone</th>
                    <th class="text-center" style="width: 140px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% students.forEach(function(student, index) { %>
                    <tr>
                      <td class="text-muted fw-semibold">
                        <%= (page - 1) * limit + (index + 1) %>
                      </td>
                      <td>
                        <div class="student-name-cell">
                          <div class="student-avatar">
                            <%= student.name ? student.name.charAt(0).toUpperCase() : 'S' %>
                          </div>
                          <div>
                            <a href="/students/<%= student._id %>" class="fw-bold text-dark text-decoration-none">
                              <%= student.name %>
                            </a>
                            <div class="text-muted small"><%= student.gender %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="roll-badge"><%= student.rollNumber %></span>
                      </td>
                      <td class="small">
                        <a href="mailto:<%= student.email %>" class="text-secondary text-decoration-none">
                          <%= student.email %>
                        </a>
                      </td>
                      <td>
                        <span class="badge-soft badge-soft-primary"><%= student.course %></span>
                      </td>
                      <td class="small text-dark fw-medium">
                        <%= student.branch %>
                      </td>
                      <td>
                        <span class="badge-soft badge-soft-secondary"><%= student.year %></span>
                      </td>
                      <td class="small text-muted font-monospace">
                        <%= student.phone %>
                      </td>
                      <td>
                        <div class="d-flex align-items-center justify-content-center gap-1">
                          <!-- View Button -->
                          <a href="/students/<%= student._id %>" class="btn-action-icon" title="View Profile">
                            <i class="fa-solid fa-eye"></i>
                          </a>
                          <!-- Edit Button -->
                          <a href="/students/<%= student._id %>/edit" class="btn-action-icon" title="Edit Record">
                            <i class="fa-solid fa-pen-to-square"></i>
                          </a>
                          <!-- Delete Button (triggers modal) -->
                          <button 
                            type="button" 
                            class="btn-action-icon btn-danger-icon" 
                            title="Delete Student"
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteConfirmModal"
                            data-student-id="<%= student._id %>"
                            data-student-name="<%= student.name %>"
                            data-student-roll="<%= student.rollNumber %>"
                          >
                            <i class="fa-solid fa-trash-can"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Pagination Bar -->
            <% if (totalPages > 1) { %>
              <div class="d-flex align-items-center justify-content-between p-3 border-top bg-light">
                <div class="small text-muted">
                  Showing <strong><%= (page - 1) * limit + 1 %></strong> to <strong><%= Math.min(page * limit, totalStudents) %></strong> of <strong><%= totalStudents %></strong> students
                </div>

                <nav aria-label="Students pagination">
                  <ul class="pagination pagination-sm mb-0">
                    <!-- Previous Page -->
                    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="/students?page=<%= page - 1 %>&search=<%= encodeURIComponent(filters.search) %>&course=<%= encodeURIComponent(filters.course) %>&branch=<%= encodeURIComponent(filters.branch) %>&year=<%= encodeURIComponent(filters.year) %>&gender=<%= encodeURIComponent(filters.gender) %>" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                      </a>
                    </li>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= page === i ? 'active' : '' %>">
                        <a class="page-link" href="/students?page=<%= i %>&search=<%= encodeURIComponent(filters.search) %>&course=<%= encodeURIComponent(filters.course) %>&branch=<%= encodeURIComponent(filters.branch) %>&year=<%= encodeURIComponent(filters.year) %>&gender=<%= encodeURIComponent(filters.gender) %>">
                          <%= i %>
                        </a>
                      </li>
                    <% } %>

                    <!-- Next Page -->
                    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="/students?page=<%= page + 1 %>&search=<%= encodeURIComponent(filters.search) %>&course=<%= encodeURIComponent(filters.course) %>&branch=<%= encodeURIComponent(filters.branch) %>&year=<%= encodeURIComponent(filters.year) %>&gender=<%= encodeURIComponent(filters.gender) %>" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                      </a>
                    </li>
                  </ul>
                </nav>
              </div>
            <% } %>

          <% } else { %>
            <div class="text-center py-5">
              <div class="mb-3 text-muted">
                <i class="fa-solid fa-user-xmark fs-1"></i>
              </div>
              <h5 class="fw-bold text-dark">No Students Found</h5>
              <p class="text-muted small mb-3">No student records match your query or filter criteria.</p>
              <div class="d-flex justify-content-center gap-2">
                <a href="/students" class="btn btn-custom-secondary btn-sm">Clear Filters</a>
                <a href="/students/add" class="btn btn-custom-primary btn-sm">Add New Student</a>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Delete Confirmation Modal Dialog -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-0 pb-0">
        <div class="rounded-circle bg-danger-subtle p-3 text-danger me-2">
          <i class="fa-solid fa-triangle-exclamation fs-4"></i>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center pt-2">
        <h5 class="modal-title fw-bold text-dark mb-2" id="deleteModalTitle">Confirm Student Deletion</h5>
        <p class="text-muted mb-1">Are you sure you want to delete this student record from MongoDB?</p>
        <p class="fw-bold text-dark fs-6" id="studentNameToDelete">Student Name</p>
        <div class="alert alert-warning small py-2 mb-0">
          <i class="fa-solid fa-circle-info me-1"></i> This action cannot be undone. All related records will be permanently removed.
        </div>
      </div>
      <div class="modal-footer border-0 d-flex justify-content-center gap-2 pb-4">
        <button type="button" class="btn btn-custom-secondary px-4" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteStudentForm" method="POST" action="">
          <button type="submit" class="btn btn-custom-danger px-4">
            <i class="fa-solid fa-trash-can me-1"></i> Delete
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
