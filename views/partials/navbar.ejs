<header class="app-navbar">
  <div class="navbar-left">
    <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle Sidebar">
      <i class="fa-solid fa-bars"></i>
    </button>
    <h2 class="page-breadcrumb-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Portal' %></h2>
  </div>

  <div class="navbar-right">
    <!-- Quick Search bar -->
    <form action="/students" method="GET" class="navbar-search-box d-none d-md-block">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="search" placeholder="Search student or roll #..." aria-label="Search students">
    </form>

    <!-- User Profile Dropdown -->
    <% if (currentUser) { %>
      <div class="dropdown">
        <button class="btn d-flex align-items-center gap-2 p-1 border-0 bg-transparent text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="user-avatar-sm">
            <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
          </div>
          <div class="d-none d-lg-block">
            <div class="fw-semibold text-dark small leading-tight"><%= currentUser.name %></div>
            <div class="text-muted" style="font-size: 0.72rem;"><%= currentUser.email %></div>
          </div>
          <i class="fa-solid fa-chevron-down text-muted small ms-1"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-3">
          <li><h6 class="dropdown-header">Signed in as <strong><%= currentUser.name %></strong></h6></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item py-2" href="/profile"><i class="fa-solid fa-user-gear me-2 text-primary"></i>My Profile</a></li>
          <li><a class="dropdown-item py-2" href="/students/add"><i class="fa-solid fa-user-plus me-2 text-success"></i>Enroll Student</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout</a></li>
        </ul>
      </div>
    <% } else { %>
      <div class="d-flex align-items-center gap-2">
        <a href="/login" class="btn btn-sm btn-outline-primary rounded-pill px-3">Login</a>
        <a href="/signup" class="btn btn-sm btn-primary rounded-pill px-3">Get Started</a>
      </div>
    <% } %>
  </div>
</header>
